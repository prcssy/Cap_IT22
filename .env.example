VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key
# Dev only (npm run dev): a fixed App Check debug token shared by every local
# browser. Register it once in Firebase Console > App Check > Apps > Manage
# debug tokens. Never used by the production build.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
