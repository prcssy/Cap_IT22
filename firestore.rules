rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffEmail() {
      return request.auth.token.email.lower();
    }

    function isStaff() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(staffEmail())) ||
        exists(/databases/$(database)/documents/moderators/$(staffEmail())) ||
        exists(/databases/$(database)/documents/superadmins/$(staffEmail()))
      );
    }

    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superadmins/$(staffEmail()));
    }

    // True if `claimedRole` is a role the CALLER'S OWN email is actually
    // entitled to — 'student' always is, anything else requires the
    // matching allowlist doc to exist for request.auth.token.email (never
    // client-supplied, comes from the signed Firebase ID token).
    function ownEmailIsAllowedRole(claimedRole) {
      return claimedRole == 'student'
        || (claimedRole == 'admin' && exists(/databases/$(database)/documents/admins/$(staffEmail())))
        || (claimedRole == 'moderator' && exists(/databases/$(database)/documents/moderators/$(staffEmail())))
        || (claimedRole == 'superadmin' && exists(/databases/$(database)/documents/superadmins/$(staffEmail())));
    }

    // ── User profiles ──────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      // A signed-in user may create/update their OWN profile doc, but
      // ONLY with a role/isAdmin combination their email is actually
      // entitled to (checked server-side above, against the SAME
      // admins/moderators/superadmins collections AuthContext resolves
      // roles from) — not whatever role/isAdmin they put in the write.
      // Before this, `allow read, write: if ... uid == uid` let any
      // signed-in student set role:'admin'/isAdmin:true on their own doc
      // directly via the SDK (e.g. devtools), which AuthContext's role
      // merge would then display as if they were staff, bypassing
      // ProtectedRoute's role gate — contained only because every
      // actually-sensitive collection checks isStaff()/isSuperAdmin()
      // against the allowlist instead of trusting this field, but still
      // a real broken-access-control gap at the source.
      allow create, update: if signedIn() && request.auth.uid == uid
                            && ownEmailIsAllowedRole(request.resource.data.role)
                            && request.resource.data.isAdmin == (
                                 request.resource.data.role == 'admin' || request.resource.data.role == 'superadmin'
                               );
      // Historical note: this branch used to be load-bearing for
      // assignStaffRole/removeStaffRole mirroring a role change onto the
      // TARGET user's profile doc from the browser. Both are now Cloud
      // Functions (Admin SDK, bypasses these rules entirely) so they can
      // also set the `role` custom claim — something no client-side write
      // could ever do. Left in place as a narrow, still-correctly-gated
      // fallback (a Super Admin editing a profile some other way), not
      // because anything in the app currently relies on it.
      allow write: if isSuperAdmin();
    }

    // ── Staff allowlists (doc id = lowercase email) ────────────
    // The ONLY writers are the assignStaffRole / removeStaffRole /
    // createStaffAccount Cloud Functions (Admin SDK, bypasses these rules
    // entirely, same trust boundary as matchRecords/teamRankings below) —
    // `write: if false` here means even a Super Admin's own browser session
    // cannot write these docs directly via the SDK, only through a Cloud
    // Function that re-verifies the caller server-side and sets the
    // matching custom claim in the same call. A superadmin can no longer
    // "self-lockout-guard bypass" this via devtools even in principle.
    //
    // `get` is scoped to the caller's OWN doc (email == staffEmail()) —
    // that's the only lookup AuthContext ever needs to resolve whether the
    // signed-in user is staff at all — plus isSuperAdmin() for the Roles &
    // Permissions panel, which is allowed to look up any specific staff
    // doc. A plain student can no longer probe a *known* admin/moderator
    // email to learn whether that person is staff (a `get` by exact id
    // used to be signedIn()-only, i.e. any email, which leaked existence
    // even though it never leaked the full roster). `list` stays narrowed
    // to isSuperAdmin() as before.
    match /admins/{email}      { allow get: if signedIn() && (email == staffEmail() || isSuperAdmin()); allow list: if isSuperAdmin(); allow write: if false; }
    match /moderators/{email}  { allow get: if signedIn() && (email == staffEmail() || isSuperAdmin()); allow list: if isSuperAdmin(); allow write: if false; }
    match /superadmins/{email} { allow get: if signedIn() && (email == staffEmail() || isSuperAdmin()); allow list: if isSuperAdmin(); allow write: if false; }

    // ── Player registrations ───────────────────────────────────
    // Students may create their own registration and read it back (their
    // own addresses/emergency contacts are their own data) — but never
    // anyone else's, and never update/delete it themselves. Staff manage
    // everything (including status changes) from AdminSchedulePage.
    match /registrations/{regId} {
      // status must start 'pending' on create — only isStaff() (updateRegistrationStatus)
      // may ever move it to 'approved'/'rejected'. Without this, a signed-in student could
      // write a pre-approved registration directly via the SDK, bypassing staff review.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Powers ProfilePage's "Submitted Registrations"/"Events Joined"
      // cards (getMyRegistrations in firestoreService.js).
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow read, update, delete: if isStaff();
    }

    // ── Public aggregate counters ───────────────────────────────
    // Mirrors event/player counts so the public landing page and the
    // registration form can read them without touching `registrations`.
    match /siteCounters/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ── Site branding / Web Customization ────────────────────────
    // Public read (the landing page and login screens are unauthenticated
    // and need the school name/logo/tagline/events), write restricted to
    // a Super Admin — same gate as the staff-allowlist docs above.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Config docs managed by staff ─────────────────────────────
    // sportsTeamsConfig and matchSchedules hold no PII (sport/team names,
    // logos, fixture date/time/venue) and are exactly what the PUBLIC
    // landing page's Ongoing Matches card and Sports Statistics/Sports
    // Available sections read for anonymous visitors — same reasoning
    // already applied to teamRankings below, so these get the same
    // public-read treatment instead of being gated to signed-in users.
    match /sportsTeamsConfig/{level} { allow read: if true; allow write: if isStaff(); }
    match /matchSchedules/{level}    { allow read: if true; allow write: if isStaff(); }
    match /venuesConfig/{docId}      { allow read: if signedIn(); allow write: if isStaff(); }

    // matchRecords/{level} holds every confirmed match's rating change
    // (prevPoints/finalPoints), computed from the K/Ppu formula in
    // functions/matchMath.js. Writing here used to be any isStaff() client
    // straight from the SDK — meaning a client could set finalPoints to
    // literally anything, with no server ever checking it matched the
    // formula. Now it's write: if false — the ONLY writers are the
    // submitMatchRecord/editMatchRecord/removeScheduledMatchRecords Cloud
    // Functions (Admin SDK, bypasses these rules entirely), which always
    // recompute finalPoints themselves from prevPoints they read fresh out
    // of teamRankings/{level}, never from anything a client sends.
    // Reads are public (same reasoning as teamRankings below — this only
    // holds sport/team names and rating deltas, never anything personal)
    // so the public landing page's Potential Champion spotlight can apply
    // the same head-to-head/point-differential tie-break RankingPage uses
    // instead of falling back to array order when ratings tie.
    match /matchRecords/{level} { allow read: if true; allow write: if false; }

    // Team rankings are shown publicly (RankingPage). Same reasoning as
    // matchRecords above — writes only ever come from the Cloud Functions
    // that also write matchRecords, in the same transaction, never
    // directly from a client.
    match /teamRankings/{level} {
      allow read: if true;
      allow write: if false;
    }

    // Schedule requests — a moderator asks the admin to arrange a fixture.
    // Staff-only both ways: moderators file requests, admins read/resolve
    // them (mark scheduled or decline), same as every other staff config
    // doc above.
    match /scheduleRequests/{docId} {
      allow read, write: if isStaff();
    }

    // ── Activity logs ───────────────────────────────────────────
    // Append-only audit trail: anyone signed in may CREATE a log entry
    // (login/logout, submitting a registration, etc. are logged by every
    // role, not just staff), but only as themselves — actorUid must match
    // the caller, so nobody can forge an entry attributed to someone else.
    // Only a Super Admin may read the log (the Roles & Permissions tab is
    // superadmin-only), and nobody may edit or delete an entry from the
    // client once written.
    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
