rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffEmail() {
      return request.auth.token.email.lower();
    }

    function isStaff() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(staffEmail())) ||
        exists(/databases/$(database)/documents/moderators/$(staffEmail())) ||
        exists(/databases/$(database)/documents/superadmins/$(staffEmail()))
      );
    }

    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superadmins/$(staffEmail()));
    }

    // ── User profiles ──────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isStaff();
      // A Super Admin assigning/removing a staff role (Roles & Permissions
      // tab) mirrors that change onto the TARGET user's own profile doc —
      // a different uid than the Super Admin's own, so the rule above
      // never covers it. Without this, assignStaffRole/removeStaffRole's
      // users/{uid} write silently failed (caught, non-fatal), so the
      // real access (admins/moderators/superadmins) updated correctly but
      // the profile doc's `role` field kept its old value — meaning a
      // reload of the Users list showed the change as having reverted.
      allow write: if isSuperAdmin();
    }

    // ── Staff allowlists (doc id = lowercase email) ────────────
    // Writable only by a verified Super Admin (via the Roles & Permissions
    // panel's assignStaffRole/removeStaffRole) — checked here server-side
    // with `isSuperAdmin()`, not just hidden client-side, so a direct API
    // request from a non-superadmin is rejected the same as a UI click
    // would be. A superadmin can never delete their OWN superadmins doc
    // (self-lockout guard — the UI also refuses this, this is the second
    // layer of the same protection).
    match /admins/{email}      { allow read: if signedIn(); allow write: if isSuperAdmin(); }
    match /moderators/{email}  { allow read: if signedIn(); allow write: if isSuperAdmin(); }
    match /superadmins/{email} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin() && email != staffEmail();
    }

    // ── Player registrations ───────────────────────────────────
    // Students may create their own registration but never read the
    // collection back (it holds addresses/emergency contacts). Staff
    // manage everything from AdminSchedulePage.
    match /registrations/{regId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isStaff();
    }

    // ── Public aggregate counters ───────────────────────────────
    // Mirrors event/player counts so the public landing page and the
    // registration form can read them without touching `registrations`.
    match /siteCounters/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ── Site branding / Web Customization ────────────────────────
    // Public read (the landing page and login screens are unauthenticated
    // and need the school name/logo/tagline/events), write restricted to
    // a Super Admin — same gate as the staff-allowlist docs above.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Config docs managed by staff ─────────────────────────────
    // sportsTeamsConfig and matchSchedules hold no PII (sport/team names,
    // logos, fixture date/time/venue) and are exactly what the PUBLIC
    // landing page's Ongoing Matches card and Sports Statistics/Sports
    // Available sections read for anonymous visitors — same reasoning
    // already applied to teamRankings below, so these get the same
    // public-read treatment instead of being gated to signed-in users.
    match /sportsTeamsConfig/{level} { allow read: if true; allow write: if isStaff(); }
    match /matchSchedules/{level}    { allow read: if true; allow write: if isStaff(); }
    match /venuesConfig/{docId}      { allow read: if signedIn(); allow write: if isStaff(); }
    match /matchRecords/{level}      { allow read: if signedIn(); allow write: if isStaff(); }

    // Team rankings are shown publicly (RankingPage), staff-managed.
    match /teamRankings/{level} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Schedule requests — a moderator asks the admin to arrange a fixture.
    // Staff-only both ways: moderators file requests, admins read/resolve
    // them (mark scheduled or decline), same as every other staff config
    // doc above.
    match /scheduleRequests/{docId} {
      allow read, write: if isStaff();
    }

    // ── Activity logs ───────────────────────────────────────────
    // Append-only audit trail: anyone signed in may CREATE a log entry
    // (login/logout, submitting a registration, etc. are logged by every
    // role, not just staff), but only as themselves — actorUid must match
    // the caller, so nobody can forge an entry attributed to someone else.
    // Only a Super Admin may read the log (the Roles & Permissions tab is
    // superadmin-only), and nobody may edit or delete an entry from the
    // client once written.
    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
