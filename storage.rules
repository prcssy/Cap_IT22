rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Registration photo/waiver uploads: registrations/{uid}/{timestamp}_photo|waiver
    // Path has no file extension, so type is enforced via contentType, not path suffix.
    match /registrations/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid; // scoped to the uploading owner —
                             // needed so getDownloadURL() succeeds right after upload in uploadFile()
                             // (src/services/firestoreService.js). Admin "View photo/waiver" links
                             // still work via the stored URL's embedded download token, which
                             // Firebase honors independently of a fresh rules evaluation.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size <= 5 * 1024 * 1024
                    && (
                         (fileName.matches('.*_photo') && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'])
                         || (fileName.matches('.*_waiver') && (
                              request.resource.contentType == 'application/pdf'
                              || request.resource.contentType == 'application/msword'
                              || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                            ))
                       );
      allow update, delete: if false; // registrations are create-once from the client
    }

    // Branding logo and Landing Page CMS images (hero background, gallery
    // photos) are NOT stored here — they're resized client-side to base64
    // data URLs and written directly onto their Firestore docs instead
    // (src/utils/resizeImage.js), same approach the Sports & Teams logo
    // upload already used. That sidesteps needing Cloud Storage/Blaze
    // provisioned on this Firebase project at all for those two features.

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
