<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and directories (assets, images, etc.) be served as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else (client-side routes like /superadmin, /admin, /dashboard)
  # falls back to index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>
